# Caminho rápido: python scripts/gerar_env.py  (cria o .env e gera os 4 segredos do sistema abaixo).
# Caminho manual: copie este arquivo para .env e preencha os campos vazios.
# O .env nunca vai para o git nem para a imagem Docker.
# Dica para criar um segredo forte à mão: python -c "import secrets; print(secrets.token_urlsafe(32))"

# ---------- Segredos do sistema (OBRIGATÓRIO; o gerar_env.py preenche os vazios) ----------
# Chave que o n8n envia ao agente no cabeçalho X-API-Key. Mínimo 32 caracteres.
AGENTE_API_KEY=
# Chave do n8n para cifrar credenciais. Se trocar depois, perde as credenciais salvas.
N8N_ENCRYPTION_KEY=
# Token que a interface (e o Slack, no futuro) envia ao webhook do n8n no cabeçalho X-Webhook-Token. Mínimo 16 caracteres.
WEBHOOK_TOKEN=
# Senha de acesso à interface web. Mínimo 12 caracteres. O usuário do login é o seu e-mail (veja abaixo).
UI_SENHA=

# ---------- Quem pode usar (OBRIGATÓRIO) ----------
# E-mails permitidos, separados por vírgula. É o usuário do login da interface. Vazio = ninguém passa.
USUARIOS_PERMITIDOS=foodlover@exemplo.com

# ---------- Interface web ----------
UI_PORTA=8080
# Endereço do webhook de produção do n8n, visto de dentro do Docker.
UI_WEBHOOK_URL=http://n8n:5678/webhook/reembolso-agente

# ---------- Agente ----------
AGENTE_SUPORTE_URL=https://suporte.interno.exemplo/reembolsos
# Limiares (valores padrão). Subir AGENTE_LIMIAR_CONFIANCA deixa o agente mais cauteloso.
AGENTE_LIMIAR_CONFIANCA=0.70
AGENTE_SCORE_MINIMO=0.10
AGENTE_SCORE_FORTE=0.25
AGENTE_TOP_K=5
# Caminhos dentro do container (mude só se montar outra base).
AGENTE_BASE_CSV=/app/data/base_conhecimento.csv
AGENTE_PEDIDOS_MOCK=/app/data/pedidos_mock.json

# ---------- LLM (opcional; VOCÊ preenche: o gerar_env.py não mexe aqui) ----------
# Deixe LLM_PROVEDOR vazio para rodar só com regras + RAG, sem nenhuma chamada a modelo.
# Provedor: anthropic ou openai (openai também serve para Azure, Ollama, vLLM etc. via LLM_URL_BASE).
LLM_PROVEDOR=
# SUA chave do provedor do modelo (a que você cria no site dele). Não é a AGENTE_API_KEY.
# Fica só no serviço do agente.
LLM_API_KEY=
# Nome do modelo, exatamente como o provedor o chama (veja a lista na documentação dele).
# Sugestão: um modelo pequeno e rápido basta para o redator; para o juiz, vale um mais capaz.
LLM_MODELO=
# Opcional: endereço base. Vazio usa o padrão do provedor.
# Sugestão para modelo local (Ollama): LLM_PROVEDOR=openai e LLM_URL_BASE=http://host.docker.internal:11434/v1
LLM_URL_BASE=
# Redator reescreve a resposta em linguagem natural; Juiz faz uma segunda avaliação e pode vetar.
LLM_REDATOR=true
LLM_JUIZ=false
# Segundos por chamada ao provedor.
LLM_TIMEOUT=10
# Com LLM ligado, o agente precisa de internet. Descomente (Windows: troque ':' por ';'):
# COMPOSE_FILE=docker-compose.yml:docker-compose.llm.yml

# ---------- n8n ----------
# Fixe uma versão (ex.: docker.n8n.io/n8nio/n8n:1.100.0) para o ambiente não mudar sozinho.
N8N_IMAGE=docker.n8n.io/n8nio/n8n:latest
N8N_PORTA=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
# Em produção, atrás de HTTPS, use N8N_PROTOCOL=https, N8N_SECURE_COOKIE=true e a URL pública acima.
N8N_SECURE_COOKIE=false
TZ=America/Sao_Paulo
