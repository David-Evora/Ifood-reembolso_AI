        "responseBody": "={{ { \"decisao\": \"FALLBACK\", \"resumo\": \"Não consegui consultar o agente agora. Encaminhe para validação manual ou abra um ticket interno.\", \"precisa_humano\": true } }}",
        "options": {
          "responseCode": 503
        }
      },
      "name": "Responder fallback (agente fora)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1040,
        380
      ]
    }
  ],
